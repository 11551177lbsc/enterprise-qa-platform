<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.haust.ailll.mapper.ChatMapper">

    <insert id="insert">

        insert into chat_message(user_id,question,answer,create_time)
        values(#{userId},#{question},#{answer},now())

    </insert>
    <select id="findByUserId" resultType="com.haust.ailll.entity.ChatMessage">
        select * from chat_message
        where user_id = #{userId}
        order by create_time desc
        limit 20
    </select>

</mapper>