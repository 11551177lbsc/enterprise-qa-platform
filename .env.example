# 复制为 .env 后填写；.env 已被 Git 忽略。
MYSQL_DATABASE=ailll
MYSQL_USERNAME=ailll
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Java 与 Python 必须使用同一 JWT 密钥，至少 32 字节。
JWT_SECRET=replace-with-at-least-32-random-bytes
# Java 内部工具网关专用，至少 32 字节，不可与 JWT_SECRET 相同。
AGENT_SERVICE_TOKEN=replace-with-another-32-byte-random-token

DASHSCOPE_API_KEY=replace-with-your-dashscope-key
LLM_API_KEY=replace-with-your-dashscope-key
LLM_MODEL=qwen-turbo
